{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postgrip.io/schemas/unified-sdk-operation-notes-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "operations": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/note" }
    }
  },
  "$defs": {
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "behavior", "lifecycle"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "behavior": { "type": "string", "minLength": 1 },
        "lifecycle": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
